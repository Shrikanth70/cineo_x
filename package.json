{
  "name": "cineo",
  "version": "1.0.0",
  "private": true,
  "description": "Cinéo - Cinema Discovery & Watch Party",
  "scripts": {
    "dev": "concurrently -k -n \"WEB,WS\" -c \"cyan,magenta\" \"next dev -p 3000\" \"tsx server/index.ts\"",
    "build": "next build",
    "start": "concurrently -k -n \"WEB,WS\" -c \"cyan,magenta\" \"next start -p 3000\" \"tsx server/index.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "0.453.0",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.5.4",
    "three": "0.170.0",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.48.1",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@types/ws": "8.5.12",
    "autoprefixer": "10.4.20",
    "concurrently": "9.0.1",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.1",
    "typescript": "5.5.4",
    "vitest": "2.1.3"
  }
}

