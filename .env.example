# Cinéo Environment Configuration
# All variables are optional; when omitted, the application boots into full Demo Mode
# with rich bundled movie fixtures, AI template answers, and in-memory WebSockets.

# TMDB API (The Movie Database)
# Obtain a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
TMDB_API_READ_ACCESS_TOKEN=

# AI Movie Query Provider (Optional - Anthropic Claude)
# If provided, natural-language cinema queries in /api/ask use Claude 3.5 Sonnet.
# If omitted, Cinéo falls back to an intelligent deterministic rule & semantic matcher.
ANTHROPIC_API_KEY=

# Watch Party Realtime Server
NEXT_PUBLIC_WS_URL=ws://localhost:3001
WS_PORT=3001

# Public Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional WebRTC TURN Server (for NAT traversal across strict firewalls)
# Format: turn:your-turn-server.com:3478
NEXT_PUBLIC_TURN_SERVER=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Redis Adapter (Optional - for clustering WebSocket servers)
# REDIS_URL=redis://localhost:6379

